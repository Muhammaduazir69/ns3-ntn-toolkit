# NTN/ns-3.43 adaptation patch - TDMA allocator no longer starves the cell when active UEs >= data symbols (UE12 livelock)
# base: upstream 5g-lena v3.3.1 plus patches 01-05
# apply from contrib/nr/ with: patch -p1 < ntn-patches/06-nr-mac-scheduler-tdma-symbol-starvation.patch
#
diff --git a/model/nr-mac-scheduler-tdma.cc b/model/nr-mac-scheduler-tdma.cc
index 7cd7d879d..c34b9a3e5 100644
--- a/model/nr-mac-scheduler-tdma.cc
+++ b/model/nr-mac-scheduler-tdma.cc
@@ -168,32 +168,48 @@ NrMacSchedulerTdma::AssignRBGTDMA(
             break;
         }
 
-        // Assign 1 entire symbol (full RBG) to the selected UE and to the total
-        // resources assigned count
-        GetRBGFn(GetUe(*schedInfoIt)) += numOfAssignableRbgs;
-        assigned.m_rbg += numOfAssignableRbgs;
-
-        GetSymFn(GetUe(*schedInfoIt)) += 1;
-        assigned.m_sym += 1;
-
-        // subtract 1 SYM from the number of sym available for the while loop
-        resources -= 1;
-
-        // Update metrics for the successful UE
-        NS_LOG_DEBUG("Assigned " << numOfAssignableRbgs << " " << type << " RBG (= 1 SYM) to UE "
-                                 << GetUe(*schedInfoIt)->m_rnti
-                                 << " total assigned up to now: " << GetRBGFn(GetUe(*schedInfoIt))
-                                 << " that corresponds to " << assigned.m_rbg);
-        SuccessfulAssignmentFn(*schedInfoIt, FTResources(numOfAssignableRbgs, 1), assigned);
-
-        // Update metrics for the unsuccessful UEs (who did not get any resource in this iteration)
-        for (auto& ue : ueVector)
+        // NTN toolkit fix (Nov 2026): keep granting symbols to the selected UE
+        // until its TB reaches the smallest size CreateDlDci (10 bytes) or
+        // CreateUlDci (12 bytes) will turn into a DCI. Upstream handed out one
+        // symbol per UE per iteration, so once the active UEs were at least as
+        // many as the data symbols, every UE got a single symbol. At the
+        // starting MCS 0 a one-symbol TB over 53 RBs is 8 bytes, so no DCI was
+        // created for anyone, no TB was sent, no CQI came back, the MCS stayed
+        // at 0 and the whole cell starved for the entire run (12 UEs on a
+        // 12-symbol slot delivered nothing while 11 UEs worked). The loop only
+        // runs more than once when a single symbol is too small to be used.
+        const uint32_t minUsefulTbs = (type == "DL") ? 10 : 12;
+        do
         {
-            if (GetUe(ue)->m_rnti != GetUe(*schedInfoIt)->m_rnti)
+            // Assign 1 entire symbol (full RBG) to the selected UE and to the total
+            // resources assigned count
+            GetRBGFn(GetUe(*schedInfoIt)) += numOfAssignableRbgs;
+            assigned.m_rbg += numOfAssignableRbgs;
+
+            GetSymFn(GetUe(*schedInfoIt)) += 1;
+            assigned.m_sym += 1;
+
+            // subtract 1 SYM from the number of sym available for the while loop
+            resources -= 1;
+
+            // Update metrics for the successful UE
+            NS_LOG_DEBUG("Assigned " << numOfAssignableRbgs << " " << type
+                                     << " RBG (= 1 SYM) to UE " << GetUe(*schedInfoIt)->m_rnti
+                                     << " total assigned up to now: "
+                                     << GetRBGFn(GetUe(*schedInfoIt)) << " that corresponds to "
+                                     << assigned.m_rbg);
+            SuccessfulAssignmentFn(*schedInfoIt, FTResources(numOfAssignableRbgs, 1), assigned);
+
+            // Update metrics for the unsuccessful UEs (who did not get any resource in this
+            // iteration)
+            for (auto& ue : ueVector)
             {
-                UnSuccessfulAssignmentFn(ue, FTResources(numOfAssignableRbgs, 1), assigned);
+                if (GetUe(ue)->m_rnti != GetUe(*schedInfoIt)->m_rnti)
+                {
+                    UnSuccessfulAssignmentFn(ue, FTResources(numOfAssignableRbgs, 1), assigned);
+                }
             }
-        }
+        } while (resources > 0 && GetTBSFn(GetUe(*schedInfoIt)) < minUsefulTbs);
     }
 
     // Count the number of assigned symbol of each beam.
