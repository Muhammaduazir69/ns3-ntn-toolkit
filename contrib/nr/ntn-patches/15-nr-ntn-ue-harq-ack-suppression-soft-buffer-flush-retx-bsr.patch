+        return;
+    }
     // get the feedback from NrSpectrumPhy and send it through ideal PUCCH to gNB
     Ptr<NrDlHarqFeedbackMessage> msg = Create<NrDlHarqFeedbackMessage>();
     msg->SetSourceBwp(GetBwpId());
