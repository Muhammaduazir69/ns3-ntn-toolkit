# NTN/ns-3.43 adaptation patch - UE serving cell id follows handovers (UE DL RX trace and NrUeNetDevice::GetCellId used the attach-time gNB)
# base: upstream 5g-lena v3.3.1 plus patches 01-09
# apply from contrib/nr/ with: patch -p1 < ntn-patches/10-nr-ue-serving-cell-id-after-handover.patch
#
diff --git a/model/nr-spectrum-phy.cc b/model/nr-spectrum-phy.cc
--- a/model/nr-spectrum-phy.cc
+++ b/model/nr-spectrum-phy.cc
@@ -1544,10 +1544,14 @@
             {
                 Ptr<NrUePhy> phy = (DynamicCast<NrUePhy>(m_phy));
                 uint8_t cqi = phy->ComputeCqi(m_sinrPerceived);
+                // ntn-patch 10: label the TB with the UE's SERVING cell, not
+                // the attach-time gNB (GetTargetGnb() is never updated by a
+                // handover, so every TB after the first X2 handover carried
+                // the old cell id and (cellId, RNTI) consumers lost the UE).
                 RxPacketTraceParams traceParams(tbInfo,
                                                 m_dataErrorModelEnabled,
                                                 rnti,
-                                                ueRx->GetTargetGnb()->GetCellId(),
+                                                ueRx->GetCellId(),
                                                 GetBwpId(),
                                                 cqi);
                 m_rxPacketTraceUe(traceParams);
diff --git a/model/nr-ue-net-device.cc b/model/nr-ue-net-device.cc
--- a/model/nr-ue-net-device.cc
+++ b/model/nr-ue-net-device.cc
@@ -264,6 +264,18 @@
 uint16_t
 NrUeNetDevice::GetCellId() const
 {
+    // ntn-patch 10: the SERVING cell is the one the UE RRC is synchronized to.
+    // m_targetGnb is written once, by NrHelper::AttachToGnb, and nothing
+    // updates it when an X2 handover (TS 38.331 5.3.5.5.2 reconfigurationWithSync)
+    // moves the UE, so it names the attach-time cell for the rest of the run.
+    // NrUeRrc::m_cellId is the targetPhysCellId of the last reconfiguration
+    // (or the cell selected at attach), so it equals the old answer until the
+    // first handover and follows the UE afterwards. Before the RRC has a cell
+    // (0), fall back to the attach-time gNB exactly as before.
+    if (m_rrc && m_rrc->GetCellId() != 0)
+    {
+        return m_rrc->GetCellId();
+    }
     auto gnb = GetTargetGnb();
     if (gnb)
     {
diff --git a/model/nr-ue-net-device.h b/model/nr-ue-net-device.h
--- a/model/nr-ue-net-device.h
+++ b/model/nr-ue-net-device.h
@@ -88,7 +88,12 @@
     uint64_t GetImsi() const;
 
     /**
-     * \brief Get the CellId
+     * \brief Get the CellId of the serving cell
+     *
+     * ntn-patch 10: the cell the UE RRC is currently synchronized to, which
+     * follows handovers; the attach-time gNB (GetTargetGnb()) only until the
+     * RRC has a cell, and UINT16_MAX when neither exists.
+     *
      * \return cell ID
      */
     uint16_t GetCellId() const;
