+    std::map<uint16_t, std::map<uint16_t, std::pair<UeMeasurementsElement, Time>>> m_ssbBeamLast;
+    /// ntn-patch 21 (attribute SsbBeamResultLifetime).
+    Time m_ssbBeamResultLifetime{Seconds(0)};
