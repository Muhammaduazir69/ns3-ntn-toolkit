+{
+    NS_LOG_FUNCTION(this << beams.size());
+    NS_ABORT_MSG_IF(beams.size() > 255, "at most 255 SSB beams (index 255 means no sweep)");
+    m_ssbSweep = beams;
+    if (m_ssbSweepNext >= m_ssbSweep.size())
+    {
+        m_ssbSweepNext = 0;
+    }
+    if (m_ssbSweep.empty())
