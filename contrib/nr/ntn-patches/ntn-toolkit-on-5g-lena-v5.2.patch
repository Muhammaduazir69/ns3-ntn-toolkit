 #include "ns3/uinteger.h"
 #include "ns3/uniform-planar-array.h"
 
+namespace
+{
+/**
+ * ntn-patch 23: since ns-3.48 (#1314) the long-term channel component is w_u^H H w_s, the
+ * receive side of the matrix being combined with the conjugate of its weights. The direct-path
+ * weights are transmit (precoding) weights exp(-j k.r), right as is for the s-side gNB, so the
+ * u-side UE needs their conjugate to combine coherently (the realistic algorithm got the same fix
+ * upstream, 02da6eef). Without it a multi-element UE array loses array gain as the direction to
+ * the gNB moves away from broadside (measured on a LEO pass, 1x2 UE: 21 -> 9 dB over 19 s); a
+ * 1x1 UE is unaffected. The toolkit keeps the gNB on the s side of every gNB-UE matrix
+ * (sticky orientation in ThreeGppChannelModel, beam priming in the helper).
+ *
+ * @param w the direct-path weights toward the gNB
+ * @return the UE combining weights
+ */
+ns3::PhasedArrayModel::ComplexVector
+ConjugateUeWeights(ns3::PhasedArrayModel::ComplexVector w)
+{
+    for (size_t i = 0; i < w.GetSize(); ++i)
+    {
+        w[i] = std::conj(w[i]);
+    }
+    return w;
+}
+} // namespace
